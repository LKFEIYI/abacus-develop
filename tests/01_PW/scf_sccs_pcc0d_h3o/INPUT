init_wfc atomic
imp_sol 2
sccs_preset custom
sccs_epsilon 1.1
sccs_maxiter 200
sccs_tol_rms 1e-10
sccs_tol_max 1e-8
assume_isolated pcc_0d
nelec_delta -1
sccs_lowpass_p1 10
sccs_lowpass_p2 5
sccs_start_drho 1e-8
