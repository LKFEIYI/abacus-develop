INPUT_PARAMETERS
suffix autotest
calculation relax
basis_type pw
ks_solver cg
pseudo_dir ../../PP_ORB
ntype 2
nbands 8
ecutwfc 20
scf_thr 1e-9
scf_nmax 200
mixing_type pulay
mixing_beta 0.2
smearing_method fixed
symmetry 0
cal_force 1
init_wfc atomic
imp_sol 2
sccs_preset custom
sccs_epsilon 1.1
sccs_maxiter 200
sccs_tol_rms 1e-10
sccs_tol_max 1e-8
assume_isolated pcc_2d
pcc_2d_axis 1
nelec_delta -1
relax_nmax 2
relax_method bfgs
force_thr_ev 0.001
sccs_lowpass_p1 10
sccs_lowpass_p2 5
pw_seed 1
relax_bfgs_rmax 0.1
relax_bfgs_init 0.05
sccs_solvent_mode full
sccs_corespread 1.0
sccs_start_drho 1e-5
sccs_start_nmax 50
